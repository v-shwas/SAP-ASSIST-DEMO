// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id         String  @id @default(cuid())
  clerkOrgId String  @unique
  name       String
  slug       String  @unique
  plan       Plan    @default(STARTER)
  sapConfig  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  conversations Conversation[]
  apiKeys       ApiKey[]
}

model User {
  id          String @id @default(cuid())
  clerkUserId String @unique
  tenantId    String
  email       String
  name        String?
  role        Role   @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([tenantId])
}

model Conversation {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  title    String @default("New Conversation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([tenantId])
  @@index([userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  toolCalls      Json?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model ApiKey {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  keyHash   String    @unique
  lastUsed  DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

enum Plan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum MessageRole {
  user
  assistant
  system
}

// ─── SAP Demo Data Models (Tirupathi Oils) ───

model SapProduct {
  id        String @id @default(cuid())
  code      String @unique
  name      String
  category  String @default("Edible Oil")
  revenue   Float
  cost      Float
  marginPct Float
  orders    Int

  inventory SapInventory[]

  @@map("sap_products")
}

model SapCustomer {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  segment     String
  gstin       String?
  creditLimit Float
  outstanding Float   @default(0)
  agingDays   Int     @default(0)
  riskLevel   String  @default("Low")

  orders SapOrder[]

  @@map("sap_customers")
}

model SapOrder {
  id          String   @id @default(cuid())
  orderId     String   @unique
  customerId  String
  product     String
  value       Float
  status      String
  date        DateTime
  delayReason String?

  customer SapCustomer @relation(fields: [customerId], references: [id])
  shipment SapShipment?

  @@map("sap_orders")
}

model SapShipment {
  id          String    @id @default(cuid())
  deliveryId  String    @unique
  orderId     String    @unique
  carrier     String
  status      String
  product     String
  eta         DateTime
  actual      DateTime?
  delayReason String?

  order SapOrder @relation(fields: [orderId], references: [orderId])

  @@map("sap_shipments")
}

model SapInventory {
  id           String @id @default(cuid())
  materialCode String
  productId    String
  plant        String
  stock        Int
  stockValue   Float
  safetyStock  Int
  coverageDays Int
  unit         String @default("Cases")
  aiSignal     String

  product SapProduct @relation(fields: [productId], references: [id])

  @@unique([materialCode, plant])
  @@map("sap_inventory")
}

model SapSupplier {
  id           String @id @default(cuid())
  vendorId     String @unique
  name         String
  category     String
  onTimePct    Float
  qualityScore Float
  activePos    Int

  @@map("sap_suppliers")
}

model SapRevenue {
  id        String @id @default(cuid())
  period    String
  revenue   Float
  target    Float
  yoyGrowth Float
  type      String @default("monthly")

  @@unique([period, type])
  @@map("sap_revenue")
}

model SapGstRecord {
  id          String @id @default(cuid())
  gstin       String
  party       String
  booksAmount Float
  gstPortal   Float
  diff        Float
  status      String
  period      String

  @@map("sap_gst_records")
}

model SapSalesOrg {
  id              String @id @default(cuid())
  code            String @unique
  name            String
  forecastRevenue Float
  growthPct       Float
  confidence      Float
  keyDriver       String

  @@map("sap_sales_orgs")
}

model SapPlant {
  id           String @id @default(cuid())
  code         String @unique
  name         String
  stockValue   Float
  deadStockPct Float
  overstockPct Float
  stockoutRisk String

  @@map("sap_plants")
}

model SapRiskRegion {
  id            String @id @default(cuid())
  region        String @unique
  overdueAmount Float
  avgDelayDays  Int
  riskScore     String

  @@map("sap_risk_regions")
}
